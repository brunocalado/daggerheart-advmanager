{
  "name": "daggerheart-advmanager",
  "version": "0.2.4",
  "private": true,
  "description": "GM companion for Daggerheart in Foundry VTT — adversary scaling, encounter builder, live preview.",
  "scripts": {
    "build": "sass styles/scss/style.scss styles/style.css --no-source-map --style=compressed",
    "watch": "sass styles/scss/style.scss styles/style.css --watch --no-source-map --style=expanded",
    "pack": "node tools/build-packs.mjs pack",
    "unpack": "node tools/build-packs.mjs unpack"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "sass": "^1.85.0"
  }
}
