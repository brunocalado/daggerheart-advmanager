<!-- Roll Type Buttons (Dis/Norm/Adv) -->
<div class="stat-row">
    <span class="stat-label">{{localize "DH_ADVMANAGER.DICE.rollTypeLabel"}}</span>
    <div class="roll-type-buttons dp-roll-type">
        <button type="button"
            data-action="setRollType"
            data-value="-1"
            class="roll-btn {{#if isDisadvantage}}active{{/if}}"
            title="{{disTitle}}">
            {{localize "DH_ADVMANAGER.DICE.rollType.dis"}}
        </button>
        <button type="button"
            data-action="setRollType"
            data-value="0"
            class="roll-btn {{#if isNormal}}active{{/if}}"
            title="{{normTitle}}">
            {{localize "DH_ADVMANAGER.DICE.rollType.norm"}}
        </button>
        <button type="button"
            data-action="setRollType"
            data-value="1"
            class="roll-btn {{#if isAdvantage}}active{{/if}}"
            title="{{advTitle}}">
            {{localize "DH_ADVMANAGER.DICE.rollType.adv"}}
        </button>
    </div>
</div>