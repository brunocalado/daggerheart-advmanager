<div class="dh-adv-manager-content preview-container">

    {{> "modules/daggerheart-advmanager/templates/partials/lm-controls.hbs"}}

    {{#if hasActor}}

    <!-- Tier Selection Tabs -->
    <div class="tier-tabs">
        <div class="tier-control-row">
            <label class="tier-control-label">{{localize "DH_ADVMANAGER.LIVE.targetTier"}}</label>
            <div class="tier-buttons tier-buttons-flush">
                {{#each tiers}}
                <button type="button"
                        class="tier-tab-btn {{this.cssClass}}"
                        data-action="selectTier"
                        data-tier="{{this.value}}">
                    {{this.label}}
                </button>
                {{/each}}
            </div>
        </div>
    </div>

    <!-- Split View Body -->
    <div class="preview-body">

        {{> "modules/daggerheart-advmanager/templates/partials/lm-current-stats.hbs"}}

        {{> "modules/daggerheart-advmanager/templates/partials/lm-preview-stats.hbs"}}

    </div>

    <footer class="sheet-footer">
        <div class="footer-row">
            <button type="button" data-action="applyChanges" class="apply-btn">
                {{#if (eq linkData null)}}
                    <i class="fas fa-file-import"></i> {{localize "DH_ADVMANAGER.LIVE.importApply" tier=previewStats.tier}}
                {{else}}
                    <i class="fas fa-bolt"></i> {{localize "DH_ADVMANAGER.LIVE.apply" tier=previewStats.tier name=actorName}}
                {{/if}}
            </button>
            <button type="button" data-action="toggleOverwriteActor" class="overwrite-actor-toggle {{#if overwriteWorldActor}}active{{/if}}" title="{{#if overwriteWorldActor}}{{localize "DH_ADVMANAGER.LIVE.copyOn"}}{{else}}{{localize "DH_ADVMANAGER.LIVE.copyOff"}}{{/if}}">
                <i class="fas fa-copy"></i> {{localize "DH_ADVMANAGER.LIVE.copy"}}
            </button>
            <button type="button" data-action="toggleOpenSheet" class="open-sheet-toggle {{#if openAfterApply}}active{{/if}}" title="{{localize "DH_ADVMANAGER.LIVE.openAfterApply"}}">
                <i class="fas fa-external-link-alt"></i>
            </button>
        </div>
    </footer>

    {{else}}
    <div class="empty-state">
        <i class="fas fa-skull empty-state-icon"></i>
        <p>{{localize "DH_ADVMANAGER.LIVE.empty"}}</p>
    </div>
    {{/if}}

</div>